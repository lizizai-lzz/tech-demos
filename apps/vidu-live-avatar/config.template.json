{
  "vidu": {
    "env": "cn",
    "api_key_file": "~/.deepsea/vidu/api.key",
    "model": "vidu-s2",
    "call_mode": "video",
    "rtc_provider": "artc",
    "max_tokens": 80,
    "enable_recording": true,
    "credit_price_rmb": 0.03125,
    "credits_per_second": 1.5
  },
  "avatar_profile": "zizai-demo",
  "avatars": {
    "zizai-demo": {
      "name": "自在",
      "image": "assets/avatars/zizai-demo.jpg",
      "voice": "Qiao",
      "persona_file": "personas/zizai-demo.md",
      "greeting_instruction": "用一句很短的话热情打招呼，说自己是自在，欢迎大家来看模拟直播。"
    }
  },
  "schedule": {
    "interval_seconds": 20,
    "policy": "random_recent",
    "max_age_seconds": 180,
    "max_queue": 200,
    "idle_prompt_after_seconds": 45
  },
  "safety": {
    "max_session_minutes": 3,
    "budget_credits": 400
  },
  "generator": {
    "enabled": false,
    "api_key_file": "~/.deepsea/evolink/api.key",
    "model": "gpt-image-2.5-sunburst",
    "resolution": "1K",
    "quality": "medium",
    "timeout_seconds": 180
  },
  "server": {
    "host": "127.0.0.1",
    "port": 28900
  }
}
